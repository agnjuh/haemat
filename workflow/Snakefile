rule program_scoring:
    input:
        data="data/pbmc10k.h5ad",
        script="scripts/program_scoring.py"
    output:
        scores="results/program_scores/program_scores.csv",
        summary="results/program_scores/program_score_summary.csv"
    shell:
        "python scripts/program_scoring.py"


rule transitional_state_detection:
    input:
        decision="results/cross_dataset/decision_table.csv",
        scores="results/program_scores/program_scores.csv",
        script="scripts/transitional_state_detection.py"
    output:
        table="results/transitional_states/transitional_state_table.csv",
        summary="results/transitional_states/transitional_summary.csv",
        by_decision="results/transitional_states/transitional_by_decision.csv",
        by_true="results/transitional_states/transitional_by_true.csv"
    shell:
        "python scripts/transitional_state_detection.py"


rule plot_transitional_states:
    input:
        table="results/transitional_states/transitional_state_table.csv",
        script="scripts/plot_transitional_states.py"
    output:
        counts="results/transitional_states/transitional_state_counts.png",
        landscape="results/transitional_states/ambiguity_landscape.png",
        heatmap="results/transitional_states/decision_by_transitional_state.png"
    shell:
        "python scripts/plot_transitional_states.py"


rule program_scores_by_state:
    input:
        table="results/transitional_states/transitional_state_table.csv",
        script="scripts/plot_program_scores_by_state.py"
    output:
        mean_scores="results/transitional_states/mean_program_scores_by_state.csv",
        heatmap="results/transitional_states/program_scores_by_transitional_state.png",
        focused_heatmap="results/transitional_states/program_scores_by_transitional_state_focused.png"
    shell:
        "python scripts/plot_program_scores_by_state.py"


rule build_sample_features:
    input:
        table="results/transitional_states/transitional_state_table.csv",
        script="scripts/build_sample_features.py"
    output:
        features="results/sample_level/sample_features.csv"
    shell:
        "python scripts/build_sample_features.py"


rule transitional_summary_figure:
    input:
        table="results/transitional_states/transitional_state_table.csv",
        summary="results/transitional_states/transitional_summary.csv",
        mean_scores="results/transitional_states/mean_program_scores_by_state.csv",
        sample_features="results/sample_level/sample_features.csv",
        script="scripts/make_transitional_summary_figure.py"
    output:
        png="results/transitional_states/transitional_summary_figure.png",
        pdf="results/transitional_states/transitional_summary_figure.pdf"
    shell:
        "python scripts/make_transitional_summary_figure.py"