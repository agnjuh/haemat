rule benchmark_celltypist_pbmc10k:
    input:
        data="data/pbmc10k.h5ad",
        script="scripts/benchmark_celltypist_pbmc10k.py"
    output:
        labels="results/celltypist_pbmc10k_labels.csv",
        mapped="results/celltypist_pbmc10k_mapped.csv"
    shell:
        """
        python scripts/benchmark_celltypist_pbmc10k.py

        python - << 'PY'
import pandas as pd

df = pd.read_csv("results/celltypist_pbmc10k_labels.csv")

def map_label(x):
    x = str(x).lower()
    if "b cell" in x or "plasma" in x:
        return "B"
    if "nk" in x:
        return "NK"
    if "t cell" in x or "mait" in x or "regulatory t" in x:
        return "T"
    if "mono" in x:
        return "Mono"
    if x.startswith("dc") or "dendritic" in x or "pdc" in x:
        return "DC"
    if "platelet" in x or "megakaryocyte" in x:
        return "Platelet"
    return "Unknown"

df["mapped"] = df["celltypist_label"].apply(map_label)
df.to_csv("results/celltypist_pbmc10k_mapped.csv", index=False)
PY
        """


rule plot_benchmark_comparison:
    input:
        decision="results/cross_dataset/decision_table.csv",
        celltypist="results/celltypist_pbmc10k_mapped.csv",
        script="scripts/plot_benchmark_comparison.py"
    output:
        "results/benchmark_plots/confusion_haemat_vs_proxy.png",
        "results/benchmark_plots/confusion_celltypist_vs_proxy.png",
        "results/benchmark_plots/agreement_by_proxy_class.csv",
        "results/benchmark_plots/agreement_by_proxy_class.png",
        "results/benchmark_plots/nk_failure_distribution.csv",
        "results/benchmark_plots/nk_failure_comparison.png",
        "results/benchmark_plots/entropy_correct_vs_incorrect.png",
        "results/benchmark_plots/top2_gap_correct_vs_incorrect.png"
    shell:
        "python scripts/plot_benchmark_comparison.py"


# Optional stress-test targets.
# These rerun the cross-dataset pipeline multiple times and should be called explicitly.

rule marker_robustness:
    input:
        markers="markers_curated.csv",
        script="scripts/marker_robustness.py",
        cross_script="scripts/cross_dataset.py",
        decision_script="scripts/decision_layer.py"
    output:
        "results/robustness/marker_robustness.csv"
    shell:
        "python scripts/marker_robustness.py"


