rule ambiguous_neighbour_filter:
    input:
        table="results/dynamics/identity_dynamics_table.csv"
    output:
        counts="results/dynamics/ambiguous_neighbour_counts.csv",
        matrix="results/dynamics/ambiguous_neighbour_matrix.csv",
        filtered="results/dynamics/ambiguous_neighbour_matrix_filtered.csv",
        clean="results/dynamics/ambiguous_neighbour_matrix_filtered_clean.csv"
    shell:
        """
        python - << 'PY'
import pandas as pd

df = pd.read_csv("results/dynamics/identity_dynamics_table.csv")

sub = df[(df["top2_gap"] < 0.2) | (df["entropy_normalized"] > 0.3)].copy()

counts = pd.crosstab(sub["top1_class"], sub["second_class"])
matrix = counts.div(counts.sum(axis=1), axis=0)

counts.to_csv("results/dynamics/ambiguous_neighbour_counts.csv")
matrix.to_csv("results/dynamics/ambiguous_neighbour_matrix.csv")

filtered = matrix.copy()

if "Platelet" in filtered.columns:
    filtered["Platelet"] = 0

if "Platelet" in filtered.index:
    filtered.loc["Platelet"] = 0

filtered = filtered.div(filtered.sum(axis=1), axis=0)
filtered.to_csv("results/dynamics/ambiguous_neighbour_matrix_filtered.csv")

clean = filtered.fillna(0)
clean = clean.loc[(clean.sum(axis=1) > 0), (clean.sum(axis=0) > 0)]
clean.to_csv("results/dynamics/ambiguous_neighbour_matrix_filtered_clean.csv")
PY
        """


